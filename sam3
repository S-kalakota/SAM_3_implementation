#!/usr/bin/env bash
set -Eeuo pipefail

PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="${PROJECT_ROOT}/docker-compose.mask-service.yml"
SERVICE_NAME="mask_service"
HEALTH_URL="${SAM3_HEALTH_URL:-http://127.0.0.1:8765/health}"
PYTHON_BIN="${PROJECT_ROOT}/.venv/bin/python"
CLIENT_SCRIPT="${PROJECT_ROOT}/scripts/mask_client.py"
START_TIMEOUT="${SAM3_START_TIMEOUT:-180}"

usage() {
    cat <<'EOF'
SAM 3.1 command-line entry point

Normal use:
  ./sam3 "orange and white box"     Start if needed, then segment
  ./sam3 orange and white box       Quotes are optional

Service commands:
  ./sam3 start                      Start and wait until ready
  ./sam3 status                     Show service health
  ./sam3 logs                       Follow service logs
  ./sam3 restart                    Recreate and restart the service
  ./sam3 stop                       Stop service and release the camera
  ./sam3 rebuild                    Rebuild after Docker/dependency changes

Prompt options accepted by the client:
  --no-agent-fallback               Use direct SAM only
  --timeout SECONDS                 Override the request timeout

Environment overrides:
  SAM3_START_TIMEOUT                Startup wait in seconds (default: 180)
  SAM3_HEALTH_URL                   Health endpoint URL
EOF
}

require_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "Required command not found: $1" >&2
        exit 1
    fi
}

check_client_prerequisites() {
    require_command curl
    if [[ ! -x "${PYTHON_BIN}" ]]; then
        echo "Python environment not found: ${PYTHON_BIN}" >&2
        exit 1
    fi
    if [[ ! "${START_TIMEOUT}" =~ ^[1-9][0-9]*$ ]]; then
        echo "SAM3_START_TIMEOUT must be a positive integer." >&2
        exit 1
    fi
}

check_docker_prerequisites() {
    require_command docker
    if ! docker compose version >/dev/null 2>&1; then
        echo "Docker Compose is not available." >&2
        exit 1
    fi
}

compose() {
    docker compose -f "${COMPOSE_FILE}" "$@"
}

service_is_ready() {
    curl --fail --silent --show-error --max-time 2 "${HEALTH_URL}" >/dev/null 2>&1
}

compose_service_is_running() {
    command -v docker >/dev/null 2>&1 \
        && docker compose -f "${COMPOSE_FILE}" ps --status running --services 2>/dev/null \
            | grep -Fxq "${SERVICE_NAME}"
}

native_service_pids() {
    local pid
    while IFS= read -r pid; do
        if [[ -n "${pid}" ]] \
            && [[ "$(readlink -f "/proc/${pid}/cwd" 2>/dev/null || true)" == "${PROJECT_ROOT}" ]]; then
            echo "${pid}"
        fi
    done < <(pgrep -u "$(id -u)" -f 'python.*scripts/mask_service[.]py' || true)
}

service_runtime() {
    local native_pids
    if compose_service_is_running; then
        echo "Docker Compose"
        return
    fi
    native_pids="$(native_service_pids | paste -sd, -)"
    if [[ -n "${native_pids}" ]]; then
        echo "native Python (PID ${native_pids})"
    elif service_is_ready; then
        echo "external process"
    else
        echo "stopped"
    fi
}

wait_until_ready() {
    local elapsed=0
    echo "Waiting for SAM and the ZED camera to become ready..."
    while (( elapsed < START_TIMEOUT )); do
        if service_is_ready; then
            echo "SAM 3.1 service is ready."
            return 0
        fi
        sleep 2
        (( elapsed += 2 ))
    done

    echo "Service did not become ready within ${START_TIMEOUT} seconds." >&2
    compose logs --tail=80 "${SERVICE_NAME}" >&2 || true
    return 1
}

start_service() {
    check_client_prerequisites
    if service_is_ready; then
        echo "SAM 3.1 service is already ready via $(service_runtime)."
        return 0
    fi
    check_docker_prerequisites
    echo "Starting the SAM 3.1 service..."
    compose up -d "${SERVICE_NAME}"
    wait_until_ready
}

stop_service() {
    local native_pids=()
    local pid

    check_client_prerequisites
    if compose_service_is_running; then
        check_docker_prerequisites
        compose stop "${SERVICE_NAME}"
        echo "SAM 3.1 Docker service stopped; the ZED camera is released."
        return 0
    fi

    mapfile -t native_pids < <(native_service_pids)
    if (( ${#native_pids[@]} > 0 )); then
        echo "Stopping native SAM 3.1 process: ${native_pids[*]}"
        kill -- "${native_pids[@]}"
        for _ in {1..50}; do
            local any_running=false
            for pid in "${native_pids[@]}"; do
                if [[ -d "/proc/${pid}" ]]; then
                    any_running=true
                    break
                fi
            done
            if [[ "${any_running}" == false ]]; then
                echo "SAM 3.1 native service stopped; the ZED camera is released."
                return 0
            fi
            sleep 0.2
        done
        echo "Native service did not stop cleanly; refusing to force-kill it." >&2
        return 1
    fi

    if service_is_ready; then
        echo "A service is responding at ${HEALTH_URL}, but this project does not own its process." >&2
        return 1
    fi
    echo "SAM 3.1 service is already stopped."
}

restart_service() {
    stop_service
    check_docker_prerequisites
    echo "Starting a fresh SAM 3.1 Docker service..."
    compose up -d --force-recreate "${SERVICE_NAME}"
    wait_until_ready
}

rebuild_service() {
    stop_service
    check_docker_prerequisites
    echo "Rebuilding the SAM 3.1 service image..."
    compose build "${SERVICE_NAME}"
    compose up -d --force-recreate "${SERVICE_NAME}"
    wait_until_ready
}

show_status() {
    check_client_prerequisites
    if service_is_ready; then
        echo "SAM 3.1 service is ready via $(service_runtime):"
        curl --fail --silent --show-error "${HEALTH_URL}" | "${PYTHON_BIN}" -m json.tool
        return 0
    fi

    echo "SAM 3.1 service is not ready."
    if command -v docker >/dev/null 2>&1; then
        compose ps "${SERVICE_NAME}" || true
    fi
    return 1
}

show_logs() {
    local native_pids
    if compose_service_is_running; then
        check_docker_prerequisites
        compose logs --follow --tail=200 "${SERVICE_NAME}"
        return
    fi
    native_pids="$(native_service_pids | paste -sd, -)"
    if [[ -n "${native_pids}" ]]; then
        echo "The service is a native foreground process (PID ${native_pids})."
        echo "Its live output is attached to the terminal that started it."
        return
    fi
    echo "SAM 3.1 service is not running."
}

submit_request() {
    if (( $# == 0 )); then
        echo "Provide an instruction, for example: ./sam3 \"orange box\"" >&2
        exit 2
    fi
    start_service
    "${PYTHON_BIN}" "${CLIENT_SCRIPT}" "$@"
}

if (( $# == 0 )); then
    usage
    exit 0
fi

command_name="$1"
case "${command_name}" in
    start)
        shift
        start_service
        ;;
    status)
        shift
        show_status
        ;;
    logs)
        shift
        show_logs
        ;;
    restart)
        shift
        restart_service
        ;;
    stop)
        shift
        stop_service
        ;;
    rebuild)
        shift
        rebuild_service
        ;;
    ask|run)
        shift
        submit_request "$@"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        submit_request "$@"
        ;;
esac
